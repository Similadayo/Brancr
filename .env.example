# ============================================
# Brancr Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# ============================================

# ============================================
# Core Application Settings
# ============================================
APP_ENV=development
PORT=8080
BRANCR_PUBLIC_URL=https://api.brancr.com
FRONTEND_URL=https://app.brancr.com

# ============================================
# Database Configuration
# ============================================
POSTGRES_DSN=postgres://user:password@localhost:5432/brancr?sslmode=disable
TEST_POSTGRES_DSN=postgres://user:password@localhost:5432/brancr_test?sslmode=disable

# ============================================
# Redis Configuration (Optional)
# ============================================
REDIS_ADDR=localhost:6379

# ============================================
# AI/LLM Configuration
# ============================================
OPENROUTER_MODE=free
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_BASE=

# For OpenAI direct API, use: gpt-5.1-mini
# For OpenRouter, use: openai/gpt-5.1-mini
# Other options: openai/gpt-4o-mini (cheaper), openai/gpt-4o (better quality)
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Cloudinary Configuration
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# OR use full URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ============================================
# Admin & Security
# ============================================
BRANCR_ADMIN_BOT_TOKEN=your_telegram_bot_token
ADMIN_EMAIL=admin@brancr.com
ADMIN_PASSWORD=your_secure_password
TOKEN_SECRET_KEY=your_32_byte_secret_key_for_encryption
TENANT_JWT_SECRET=your_jwt_secret_for_tenant_sessions
TENANT_COOKIE_DOMAIN=api.brancr.com

# ============================================
# Meta OAuth (Facebook/Instagram/WhatsApp)
# ============================================
# Required for Meta OAuth integration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://api.brancr.com/api/oauth/meta/callback
META_SUCCESS_REDIRECT=https://app.brancr.com/integrations?success=true

# Meta Webhook Configuration
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Meta WhatsApp Embedded Signup
META_WHATSAPP_CONFIG_ID=your_whatsapp_config_id
META_WHATSAPP_EXTRAS={"sessionInfoVersion":"3","version":"v3"}

# Meta Business Manager (Optional - for advanced features)
META_SYSTEM_USER_TOKEN=your_system_user_token
META_BUSINESS_ID=your_business_id
META_PAYMENT_METHOD_ID=your_payment_method_id
META_EXTENDED_CREDIT_ID=your_extended_credit_id
META_SYSTEM_USER_ID=your_system_user_id

# Brancr WhatsApp Business Account (Provider-owned WABA)
BRANCR_WABA_ID=your_waba_id
BRANCR_WABA_TOKEN=your_waba_token

# ============================================
# TikTok OAuth
# ============================================
# Required for TikTok OAuth integration
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://api.brancr.com/api/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.upload
TIKTOK_DEFAULT_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Optional: Secret for verifying TikTok webhook signatures (recommended for production)
TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret

# ============================================
# Gupshup Partner API (WhatsApp)
# ============================================
# Required for Gupshup WhatsApp integration
GUPSHUP_PARTNER_USERNAME=your_gupshup_email
GUPSHUP_PARTNER_PASSWORD=your_gupshup_password_or_client_secret
# For accounts after Nov 20, 2024: use Client Secret (recommended)
# For older accounts: use actual account password
GUPSHUP_PARTNER_APP_ID=your_gupshup_app_id
GUPSHUP_API_BASE_URL=https://partner.gupshup.io

# ============================================
# Respond.io (WhatsApp - Optional)
# ============================================
RESPOND_IO_API_KEY=your_respond_io_api_key

# ============================================
# YouTube (Optional)
# ============================================
YOUTUBE_API_KEY=your_youtube_api_key

# ============================================
# Email Configuration (SMTP)
# ============================================
# Required for sending receipt emails and order notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@brancr.com

# ============================================
# Customer Portal Configuration
# ============================================
# Portal token expiration in days (default: 90)
PORTAL_TOKEN_EXPIRY_DAYS=90

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.brancr.com

# ============================================
# Scheduling Defaults
# ============================================
DEFAULT_TIMEZONE=UTC

# ============================================
# Notes
# ============================================
# 1. OAuth Endpoints:
#    - Meta OAuth: /api/oauth/meta/start and /api/oauth/meta/callback
#    - TikTok OAuth: /api/oauth/tiktok/start and /api/oauth/tiktok/callback
#    - These endpoints are only registered if the required env vars are set
#
# 2. Required for OAuth to work:
#    - Meta: META_APP_ID, META_APP_SECRET, META_REDIRECT_URI
#    - TikTok: TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET, TIKTOK_REDIRECT_URI
#
# 3. Email Configuration:
#    - Required for sending receipt emails and order notifications
#    - If not configured, emails will be skipped (logged as warnings)
#
# 4. Portal Token Expiry:
#    - Default is 90 days
#    - Set PORTAL_TOKEN_EXPIRY_DAYS to change expiration period
#
# 5. Security:
#    - TOKEN_SECRET_KEY should be a 32-byte random string
#    - TENANT_JWT_SECRET should be a strong random string
#    - Never commit .env file to version control

